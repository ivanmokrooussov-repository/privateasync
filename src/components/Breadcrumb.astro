---
import { absoluteUrl } from "../lib/paths";

interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    ...(item.href ? { item: absoluteUrl(item.href) } : {}),
  })),
};
---

<nav aria-label="Breadcrumb">
  <ol class="crumbs">
    {
      items.map((item, index) => (
        <li>
          {item.href && index < items.length - 1 ? <a href={item.href}>{item.name}</a> : <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.name}</span>}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
