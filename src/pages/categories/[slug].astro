---
import Breadcrumb from "../../components/Breadcrumb.astro";
import ToolTable from "../../components/ToolTable.astro";
import { categories } from "../../lib/categories";
import { comparisons } from "../../lib/comparisons";
import { verifiedSentence } from "../../lib/format";
import { categoryHref, href } from "../../lib/paths";
import { toolsInCategory } from "../../lib/tools";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const list = toolsInCategory(category.name);
const related = category.related
  .map((path) => comparisons.find((page) => page.path === path))
  .filter((page) => page !== undefined);
const description = `${list.length} tools filed under ${category.name}. Price, encryption claim, open source, self-hosting, and jurisdiction as recorded. ${verifiedSentence(list)}`;
---

<Base title={`${category.name} | PrivateAsync`} description={description}>
  <Breadcrumb
    items={[
      { name: "Home", href: href("/") },
      { name: "Categories", href: href("/categories") },
      { name: category.name, href: categoryHref(category.slug) },
    ]}
  />
  <h1>{category.name}</h1>
  <p class="lede">{category.summary}</p>
  <p>{verifiedSentence(list)} The table is alphabetical. <a href={href("/methodology")}>Methodology</a>.</p>
  <ToolTable
    tools={list}
    columns={["name", "price", "free", "e2ee", "oss", "host", "jurisdiction", "verified"]}
    caption={`${list.length} tools in ${category.name}. “Official site” opens in a new tab.`}
  />
  {
    category.related.length > 0 && (
      <>
        <h2>Related comparisons</h2>
        <ul>
          {related.map((page) => (
            <li>
              <a href={page.path}>{page.h1}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
